<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local NuGet configuration.

  CobolSharp's only package dependencies (Antlr4.Runtime.Standard, Mono.Cecil,
  xUnit, Microsoft.NET.Test.Sdk) come from nuget.org. We <clear/> any inherited
  machine-/user-level sources and pin a single source so the build is
  reproducible regardless of the developer's global NuGet config.

  This also avoids NU1507 (raised as an error here because central package
  management is on and TreatWarningsAsErrors=true): that warning only fires when
  two or more unmapped sources are visible. Pinning one source resolves it
  without requiring package source mapping.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
