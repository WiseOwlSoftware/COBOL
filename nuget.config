<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local NuGet configuration.

  Package dependencies come from nuget.org, except ONE: Antlr4.Runtime.Standard comes from the repo-local
  feed nuget-feed/, which holds our build of the ANTLR 4.13.2 C# runtime from the fork
  WiseOwlSoftware/antlr4 with an upstream defect fixed (nuget-feed/README.md, kb/Work PB3504). We <clear/>
  any inherited machine-/user-level sources so the build is reproducible regardless of the developer's
  global NuGet config.

  Two sources are visible, so central package management (with TreatWarningsAsErrors) needs package
  source mapping (NU1507): the mapping below sends Antlr4.Runtime.Standard to the local feed ONLY, and
  every other package to nuget.org only, so no package can be satisfied from the wrong source.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="wiseowl-local" value="nuget-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="wiseowl-local">
      <package pattern="Antlr4.Runtime.Standard" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
