<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WiseOwl.Cobol.Compiler — the greenfield COBOL→C# compiler LIBRARY (blank-slate rewrite, owner directive
    2026-06-08). Bind → emit typed-native C# → Roslyn. There is NO byte-array storage substrate: a COBOL record
    is a .NET record, a COBOL elementary item is a native .NET field. See docs/DESIGN.md.

    Split out of the old exe at G0 (§17): the CLI shell is now WiseOwl.Cobol.Cli (producing cobol.exe); this library
    is what the CLI and the tests reference. RootNamespace is the single token WiseOwl.Cobol; the shared front-end's
    namespaces were renamed to WiseOwl.Cobol.Frontend.* at rearchitecture PHASE 01 (no longer a G8 big-bang).

    Front-end reuse (no byte-array substrate): the proven preprocessor + ANTLR lexer/parser live
    in WiseOwl.Cobol.Frontend; we consume ONLY its public front-end (preprocessing + parse tree).
  -->
  <PropertyGroup>
    <RootNamespace>WiseOwl.Cobol</RootNamespace>
    <AssemblyName>WiseOwl.Cobol.Compiler</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WiseOwl.Cobol.Tests.Unit" />
    <InternalsVisibleTo Include="WiseOwl.Cobol.Tests.RepoDrift" />
  </ItemGroup>

  <ItemGroup>
    <!-- Front-end only: preprocessor + ANTLR lexer/parser + parse-tree (CobolParserCore) context types
         (namespaces WiseOwl.Cobol.Frontend.*). -->
    <ProjectReference Include="..\WiseOwl.Cobol.Frontend\WiseOwl.Cobol.Frontend.csproj" />
    <!-- The edition/diagnostics leaf (rearch PHASE 02): the ONE home for ConstructRegistry / ReservedWords /
         EditionInfo / EditionSeverityPolicy / the diagnostic descriptors, referenced by both Frontend and
         Compiler so edition metadata + the severity policy are single-sourced below the frontend. -->
    <ProjectReference Include="..\WiseOwl.Cobol.Editions\WiseOwl.Cobol.Editions.csproj" />
    <!-- The runtime the GENERATED programs call: referenced so it is built + lands next to the compiler, where
         RoslynBackend deploys a copy beside each compiled program. -->
    <ProjectReference Include="..\WiseOwl.Cobol.Runtime\WiseOwl.Cobol.Runtime.csproj" />
    <!-- Roslyn: generate + compile C# at runtime. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!--
    THE REFERENCE ASSEMBLIES A GENERATED PROGRAM IS COMPILED AGAINST (kb/Work PB4047). An emitted assembly is a .NET
    library or application that an ordinary MSBuild host project references, and such a project compiles against the
    targeting pack's REFERENCE assemblies (System.Runtime, System.Console, ...). Compiled against the compiler's own
    implementation assemblies (the trusted-platform set), the emitted assembly referenced System.Private.CoreLib, which
    no reference set holds, and the host failed CS0012. So the build lays the very reference assemblies this project
    compiles against, the Microsoft.NETCore.App targeting pack the SDK resolved, at reference-assemblies/ in the output
    of every referencing project (the CLI, the test hosts) and in the CLI's publish output, which the tool package
    packs; CodeGen/AssemblyPackager.cs reads them there. Same mechanism as the runtime's ReadyToRun images
    (AssignTargetPaths precedes GetCopyToOutputDirectoryItems and GetCopyToPublishDirectoryItems).
  -->
  <Target Name="_CobolReferenceAssembliesContent" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <_CobolReferenceAssembly Include="@(Reference)" Condition="'%(Reference.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
      <None Include="@(_CobolReferenceAssembly)"
            Link="reference-assemblies$([System.IO.Path]::DirectorySeparatorChar)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
    <Error Condition="'@(_CobolReferenceAssembly)' == ''"
           Text="No Microsoft.NETCore.App reference assembly was resolved (kb/Work PB4047): the compiler deploys the targeting pack's reference assemblies, which every generated program is compiled against." />
  </Target>

  <ItemGroup>
    <!-- Build-time source generator:emits the exhaustive I{Root}Visitor<T> + Accept<T> over the [BoundNode]
         hierarchy (PHASE-07 Step 6). Analyzer-only — never a runtime dependency. -->
    <ProjectReference Include="..\WiseOwl.Cobol.Compiler.SourceGen\WiseOwl.Cobol.Compiler.SourceGen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
