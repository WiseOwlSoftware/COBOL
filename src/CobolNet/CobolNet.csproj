<Project Sdk="Microsoft.NET.Sdk">

  <!--
    COBOL.NET — the greenfield COBOL→C# compiler (blank-slate rewrite, owner directive 2026-06-08).
    Translates COBOL source to idiomatic, typed-native C# (records, native value types) and compiles it
    with Roslyn. There is NO byte-array storage substrate: a COBOL record is a .NET record, a COBOL
    elementary item is a native .NET field. See docs/COBOLNET_ARCHITECTURE.md.

    Transitional reuse (front-end only — NOT the byte engine): the proven ANTLR lexer/parser + the
    source preprocessor live in CobolSharp.Compiler; we consume ONLY its public front-end (preprocessing +
    parse tree). The semantic/codegen layers there (ProgramState, StorageLayoutComputer, the byte emitters)
    are deliberately unused and will be retired at cut-over (task G8).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>cobol</AssemblyName>
    <RootNamespace>CobolNet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Front-end only: preprocessor + ANTLR lexer/parser + parse-tree (CobolParserCore) context types. -->
    <ProjectReference Include="..\CobolSharp.Compiler\CobolSharp.Compiler.csproj" />
    <!-- Roslyn: generate + compile C# at runtime. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
