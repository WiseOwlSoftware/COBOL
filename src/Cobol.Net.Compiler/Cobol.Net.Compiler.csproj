<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cobol.Net.Compiler — the greenfield COBOL→C# compiler LIBRARY (blank-slate rewrite, owner directive
    2026-06-08). Bind → emit typed-native C# → Roslyn. There is NO byte-array storage substrate: a COBOL record
    is a .NET record, a COBOL elementary item is a native .NET field. See docs/COBOLNET_DESIGN.md.

    Split out of the old exe at G0 (§17): the CLI shell is now Cobol.Net.Cli (producing cobol.exe); this library
    is what the CLI and the tests reference. RootNamespace stays the single token CobolNet through G0-G7; the
    cosmetic namespace rename is the G8 big-bang.

    Transitional reuse (front-end only — NOT the byte engine): the proven preprocessor + ANTLR lexer/parser live
    in Cobol.Net.Frontend; we consume ONLY its public front-end (preprocessing + parse tree).
  -->
  <PropertyGroup>
    <RootNamespace>CobolNet</RootNamespace>
    <AssemblyName>Cobol.Net.Compiler</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Front-end only: preprocessor + ANTLR lexer/parser + parse-tree (CobolParserCore) context types
         (extracted out of the legacy CobolSharp.Compiler at G0; namespaces stay CobolSharp.Compiler.* until G8). -->
    <ProjectReference Include="..\Cobol.Net.Frontend\Cobol.Net.Frontend.csproj" />
    <!-- The runtime the GENERATED programs call: referenced so it is built + lands next to the compiler, where
         RoslynBackend deploys a copy beside each compiled program. -->
    <ProjectReference Include="..\Cobol.Net.Runtime\Cobol.Net.Runtime.csproj" />
    <!-- Roslyn: generate + compile C# at runtime. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
