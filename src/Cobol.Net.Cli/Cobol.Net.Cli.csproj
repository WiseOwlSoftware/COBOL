<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cobol.Net.Cli — the thin command-line shell for the COBOL.NET compiler. Produces the cobol(.exe) executable.
    All compilation logic lives in the Cobol.Net.Compiler library (this exe only parses args, prints diagnostics,
    maps the outcome to an exit code, and optionally runs the compiled program). Split from the old combined exe
    at G0 (docs/COBOLNET_DESIGN.md §17) so the compiler is testable as a library.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>cobol</AssemblyName>
    <RootNamespace>CobolNet.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cobol.Net.Compiler\Cobol.Net.Compiler.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cobol.Net.Tests.Unit" />
  </ItemGroup>

  <!-- Opt-in build hook for the Obsidian vault code-reference notes (kb/Reference/, a GITIGNORED build output).
       NOT run by default: the build does not depend on these notes (unlike the ANTLR parser, which IS a build
       prerequisite). Enable on a build with -p:GenerateVaultReference=true (e.g. a docs/CI refresh). Normally the
       generator is run by hand (pwsh scripts/gen-vault-reference.ps1), and a "runs clean" drift test
       (VaultReferenceGeneratorDriftTests) guards it in CI — matching the scripts/gen-*.ps1 + drift-test convention. -->
  <Target Name="GenerateVaultReference" AfterTargets="Build" Condition="'$(GenerateVaultReference)' == 'true'">
    <Message Text="Generating Obsidian vault code-reference (kb/Reference/)..." Importance="high" />
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../../scripts/gen-vault-reference.ps1&quot;" />
  </Target>

</Project>
