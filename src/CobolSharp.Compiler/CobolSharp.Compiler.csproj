<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CobolSharp.Compiler — the LEGACY byte-engine semantic/IR/codegen layers (Semantics/, IR/, CodeGen/,
    FlowAnalysis/, Compilation*). Kept ONLY as a differential behavioral oracle until cut-over (G8).
    The reusable front-end (preprocessor + ANTLR parser + parse tree + diagnostics) was extracted at G0 into
    Cobol.Net.Frontend; this project now consumes it like any other client (docs/COBOLNET_DESIGN.md §17).
  -->
  <PropertyGroup>
    <RootNamespace>CobolSharp.Compiler</RootNamespace>
    <AssemblyName>CobolSharp.Compiler</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CobolSharp.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" />
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CobolSharp.Runtime\CobolSharp.Runtime.csproj" />
    <ProjectReference Include="..\Cobol.Net.Frontend\Cobol.Net.Frontend.csproj" />
  </ItemGroup>

</Project>
