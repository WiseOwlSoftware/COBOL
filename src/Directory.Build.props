<Project>

  <!--
    src-tree props. MSBuild stops at the FIRST Directory.Build.props found walking up, so the repo-root one is imported
    explicitly; without this line every src project would lose TargetFramework, Nullable, TreatWarningsAsErrors and the rest.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    ⛔ THE REPOSITORY'S ANALYZERS RUN OVER EVERY src PROJECT'S REAL COMPILATION (kb/Work PB4950 round 7). Each src project
    that is not itself a Roslyn component loads src/WiseOwl.Cobol.Analyzers as an analyzer, so a rule over the product's C#
    (WOCA0001, one decider of a message's words by edition, docs/VERSION_TEST_MATRIX_DESIGN.md P2.3a) is a build ERROR in the
    compilation MSBuild actually builds: its sources, its SDK-supplied generators' output, its references. Item conditions
    are evaluated after every property, so the project's own IsRoslynComponent is already set here.
    ⛔ ONE CONFIGURATION BUILDS THE ANALYZER, whatever the referencing build passes (kb/Work PB4950 rounds 9 and 10). MSBuild
    hands a referenced project every global property of the build that references it, and it can drop only a NAMED list of
    them, never all of them. So two rules hold instead. Every reference pins the analyzer to Release (SetConfiguration): a build
    tool has one configuration, and the caller's is not its. And a nested build of a src project builds no references
    (BuildProjectReferences=false): the outer build of that project has built them, and the nested build only re-compiles the
    project itself (the runtime's per-platform ReadyToRun publishes). Before these rules each nested publish built the analyzer
    again, as another configuration, into the one obj/Release/netstandard2.0. Two builds wrote it at once (CS2012), and the
    differing assembly attributes made every Release build recompile it. scripts/test_analyzer_builds_once.py builds the runtime
    in Release twice and requires the analyzer built under exactly one configuration and not rebuilt on an unchanged tree.
    AnalyzerWiringDriftTests refuses a nested MSBuild call in src that omits BuildProjectReferences=false.
  -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)WiseOwl.Cobol.Analyzers/WiseOwl.Cobol.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"
                      SetConfiguration="Configuration=Release" />
  </ItemGroup>

</Project>
