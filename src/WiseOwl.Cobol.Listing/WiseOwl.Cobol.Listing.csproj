<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WiseOwl.Cobol.Listing — the source listing's MODEL and its RENDERERS (docs/rearchitecture/DESIGN-listing.md section 4.2;
    kb/Work PB5923, PB5925). It references NO project of the solution, so a renderer cannot reach a binder, parser or
    emitter type: "renderers read only the model" is enforced by the compiler, and docs/rearchitecture/architecture-edges.json
    gives its namespaces their own lowest layer (ArchitectureEdgesDriftTests). The compiler references it and fills the model
    (WiseOwl.Cobol.Compiler/Listing, namespace WiseOwl.Cobol.Listing.Building); a .NET tool may reference it to read a listing.
    TargetFramework / LangVersion / Nullable / ImplicitUsings / TreatWarningsAsErrors come from Directory.Build.props.
  -->
  <PropertyGroup>
    <RootNamespace>WiseOwl.Cobol.Listing</RootNamespace>
    <AssemblyName>WiseOwl.Cobol.Listing</AssemblyName>
    <!-- DESIGN-listing.md section 7.3: the JSON schema's descriptions are the model's XML documentation
         (Json/ListingJsonSchema.cs), so the documentation file is built, and with TreatWarningsAsErrors a public member
         without documentation (CS1591) fails the build: no property of the published interface goes without its meaning. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The committed, generated schema (ListingJsonSchema.Committed); ListingJsonSchemaDriftTests regenerates it. -->
    <EmbeddedResource Include="Json/listing-v1.schema.json" LogicalName="WiseOwl.Cobol.Listing.Json.listing-v1.schema.json" />
  </ItemGroup>

</Project>
