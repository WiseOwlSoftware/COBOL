<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cobol.Net.Runtime — the clean, typed-native runtime that COBOL.NET-generated C# programs call. It has
    NO byte-array storage substrate: numeric values are native long/Int128 (unscaled fixed-point) / float / double,
    character values are string. The oracle-verified CobolNum/NumProfile/CobolRounding/CobolString logic is ported
    here clean (TFM/lang come from Directory.Build.props — not re-declared).

    Renamed from CobolNet.Runtime at G0 (docs/COBOLNET_DESIGN.md §17). The assembly is Cobol.Net.Runtime; the
    root namespace stays CobolNet.Runtime until the G8 namespace flip so generated programs' `using
    CobolNet.Runtime;` is unaffected. Folders are ROLE-based (DESIGN-runtime-library §2): Values/{Numeric,Text,
    Tables}/ the value library · Verbs/ statement runtime · IO/ file connectors · Control/ run-unit +
    inter-program (+ Signals/) · Exceptions/ the EC engine · Intrinsics/ the function families.
  -->
  <PropertyGroup>
    <AssemblyName>Cobol.Net.Runtime</AssemblyName>
    <RootNamespace>CobolNet.Runtime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cobol.Net.Tests.Unit" />
  </ItemGroup>

  <!--
    The collation subsystem's data (Collation/README.md): the DERIVED root collation table generated from Unicode
    CLDR/UCA data by scripts/collation/generate-collation-table.py, and the shipped locale tailorings. Embedded with
    STABLE logical names (the runtime opens them by these strings; the RootNamespace-derived default would change
    with the G8 namespace flip).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Collation/Data/root-collation.bin" LogicalName="Collation/Data/root-collation.bin" />
    <EmbeddedResource Include="Collation/Tailoring/*.tailor" LogicalName="Collation/Tailoring/%(Filename)%(Extension)" />
    <!-- The CLDR collation data pack (Collation/CLDR/README.md): every cldr/common/collation file of the pinned
         release, zipped deterministically by scripts/collation/pack-cldr-collation.py, plus its manifest. -->
    <EmbeddedResource Include="Collation/CLDR/Data/cldr-collation.zip" LogicalName="Collation/CLDR/Data/cldr-collation.zip" />
    <EmbeddedResource Include="Collation/CLDR/Data/cldr-collation.manifest.json" LogicalName="Collation/CLDR/Data/cldr-collation.manifest.json" />
    <!-- The grapheme cluster property table (Unicode/Segmentation/README.md), generated by
         scripts/unicode/generate-grapheme-table.py from the pinned UCD files under data/unicode/. -->
    <EmbeddedResource Include="Unicode/Segmentation/Data/grapheme-break.bin" LogicalName="Unicode/Segmentation/Data/grapheme-break.bin" />
  </ItemGroup>

</Project>
