<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cobol.Net.Frontend — the reusable COBOL front-end (preprocessor + ANTLR lexer/parser + parse tree +
    diagnostics) of the WiseOwl COBOL compiler (docs/COBOLNET_DESIGN.md §17). Its namespaces are
    CobolNet.Frontend.*.
  -->
  <PropertyGroup>
    <RootNamespace>CobolNet.Frontend</RootNamespace>
    <AssemblyName>Cobol.Net.Frontend</AssemblyName>
    <!-- Single source of the generated ANTLR parser namespace (rearch P1) — threaded into the generation Exec
         below and matched by the hand-written superClass base Parsing/CobolParserCoreBase.cs. -->
    <AntlrNamespace>CobolNet.Frontend.Generated</AntlrNamespace>
    <!-- The ANTLR generation's other single-sourced inputs (kb/Work PB2719): the vendored tool jar, the one
         generator script, and the stamp that carries the values above into the up-to-date check. -->
    <AntlrJar>ANTLR4/antlr-4.13.2-complete.jar</AntlrJar>
    <AntlrGenerator>Invoke-Antlr4CSharp.ps1</AntlrGenerator>
    <AntlrGenerationStamp>$(BaseIntermediateOutputPath)antlr-generation.stamp</AntlrGenerationStamp>
    <!-- Suppress CS3021 warnings from ANTLR-generated files -->
    <NoWarn>$(NoWarn);CS3021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cobol.Net.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The edition/diagnostics leaf (rearch PHASE 02): the frontend reads the ONE ConstructRegistry +
         EditionInfo + EditionSeverityPolicy instead of re-encoding edition metadata (the parse-layer residue
         is ReservedWordEditionHints). Editions is BELOW Frontend — it references nothing here. -->
    <ProjectReference Include="..\Cobol.Net.Editions\Cobol.Net.Editions.csproj" />
    <!-- The typed-native runtime leaf (DESIGN-edition-framework: Runtime → Frontend → Compiler → Cli; the runtime
         references nothing in the solution). The compile-time expression evaluator carries its values in the ONE
         SDIDI decimal engine (CobolDec) and selects its arithmetic mode through the ONE per-edition behaviour
         register (DialectBehaviors): ISO Annex E.2 6) + 21) prescribe standard arithmetic for compile-time
         arithmetic expressions at 2002/2014, and that engine lives here (kb/Work PB1592). -->
    <ProjectReference Include="..\Cobol.Net.Runtime\Cobol.Net.Runtime.csproj" />
    <PackageReference Include="Antlr4.Runtime.Standard" />
  </ItemGroup>

  <!-- Every grammar the generator reads: the parser and every grammar it imports, in whatever Grammar/ subfolder.
       An item, because MSBuild expands a wildcard only in an item's Include, never in a target's Inputs (a literal
       `Grammar/Core/*.g4` there names a file that never exists, so the target ran on every build). The grammars,
       the jar and the script are also None items through the SDK's default globbing. -->
  <ItemGroup>
    <AntlrGrammar Include="Grammar/**/*.g4" />
  </ItemGroup>

  <!-- Generated/ is a BUILD OUTPUT (.gitignored, never checked in): ANTLR generates DIRECTLY into it
       (DEVLOG 555/556 — each grammar runs from its own directory with a bare filename, the portable fix for
       ANTLR's separator-keyed output mirroring; the parser's -lib inputs stage under obj/antlr-lib/). A fresh
       checkout regenerates, so java + pwsh are build prerequisites on every platform, and a failed generation
       FAILS the build (no stale-parser fallback — the DEVLOG-554 CI break). -->

  <!-- The stamp carries the generation's inputs that are VALUES rather than files: the -package namespace and the
       jar path. It is rewritten only when its text changes, so its timestamp moves exactly when a value does and
       the target below regenerates on a warm tree as a fresh checkout would (kb/Work PB2719). The tool flags live
       in the generator script, which is itself an input. -->
  <Target Name="WriteAntlrGenerationStamp">
    <ItemGroup>
      <_AntlrGenerationStampLine Include="package=$(AntlrNamespace)" />
      <_AntlrGenerationStampLine Include="jar=$(AntlrJar)" />
    </ItemGroup>
    <WriteLinesToFile File="$(AntlrGenerationStamp)" Lines="@(_AntlrGenerationStampLine)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- THE ONE up-to-date decision for the generated parser (kb/Work PB2719, PB2730): Generated/ is regenerated when
       it is absent or any generation input is newer than it — a grammar, the generator script, the jar, or the stamp.
       The generator keeps no staleness check of its own and takes every single-sourced value as a parameter.
       BeforeTargets="CoreCompile" so generation completes before csc runs; the generated .cs files are added to
       Compile in case they were missing during the SDK's initial globbing (a fresh checkout, after dotnet clean). -->
  <Target Name="EnsureGeneratedFiles"
          BeforeTargets="CoreCompile"
          DependsOnTargets="WriteAntlrGenerationStamp"
          Inputs="@(AntlrGrammar);$(AntlrGenerator);$(AntlrJar);$(AntlrGenerationStamp)"
          Outputs="Generated/CobolLexer.cs;Generated/CobolParserCore.cs;Generated/CobolParserCoreVisitor.cs;Generated/CobolParserCoreBaseVisitor.cs">

    <Message Text="Generating the ANTLR parser into Generated/ (absent, or a generation input is newer)." Importance="high" />

    <!-- A nonzero exit FAILS the build: the generator exits 1 on any failure and leaves Generated/ empty. -->
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/$(AntlrGenerator)&quot; -PackageName $(AntlrNamespace) -JarPath &quot;$(MSBuildProjectDirectory)/$(AntlrJar)&quot; -OutputDir &quot;$(MSBuildProjectDirectory)/Generated&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <!-- Add generated files to compilation in case they were missing during initial globbing -->
    <ItemGroup>
      <Compile Include="Generated\*.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <!-- Clean target: remove generated files AND temp folder -->
  <Target Name="CleanGenerated" AfterTargets="Clean">
    <ItemGroup>
      <GeneratedFiles Include="$(MSBuildProjectDirectory)/Generated/*.*" />
    </ItemGroup>
    <Delete Files="@(GeneratedFiles)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)/Generated" ContinueOnError="true" />
  </Target>

</Project>
