<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cobol.Net.Frontend — the reusable COBOL front-end (preprocessor + ANTLR lexer/parser + parse tree +
    diagnostics), extracted from the legacy CobolSharp.Compiler at G0 (docs/COBOLNET_DESIGN.md §17).
    This is the single front-end for BOTH the greenfield COBOL.NET compiler and (until cut-over at G8) the
    legacy byte-engine oracle. Its namespaces are CobolNet.Frontend.* as of rearchitecture PHASE 01
    (docs/rearchitecture/PHASE-01-mechanical-rename-deadcode.md) — the rename was pulled FORWARD from the former
    G8 big-bang, so G8 is now a pure DELETION of the legacy tree. The legacy tree keeps its own
    CobolSharp.Compiler.* identity (root + .Semantics/.CodeGen/.IR/.FlowAnalysis) until G8.
  -->
  <PropertyGroup>
    <RootNamespace>CobolNet.Frontend</RootNamespace>
    <AssemblyName>Cobol.Net.Frontend</AssemblyName>
    <!-- Single source of the generated ANTLR parser namespace (rearch P1) — threaded into the generation Exec
         below and matched by the hand-written superClass base Parsing/CobolParserCoreBase.cs. -->
    <AntlrNamespace>CobolNet.Frontend.Generated</AntlrNamespace>
    <!-- Suppress CS3021 warnings from ANTLR-generated files -->
    <NoWarn>$(NoWarn);CS3021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CobolSharp.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The edition/diagnostics leaf (rearch PHASE 02): the frontend reads the ONE ConstructRegistry +
         EditionInfo + EditionSeverityPolicy instead of re-encoding edition metadata (the parse-layer residue
         is ReservedWordEditionHints). Editions is BELOW Frontend — it references nothing here. -->
    <ProjectReference Include="..\Cobol.Net.Editions\Cobol.Net.Editions.csproj" />
    <PackageReference Include="Antlr4.Runtime.Standard" />
  </ItemGroup>

  <!-- Grammar files included for reference -->
  <ItemGroup>
    <None Include="Grammar\Core\CobolLexer.g4" />
    <None Include="Grammar\CobolParserCore.g4" />
    <None Include="ANTLR4\antlr-4.13.2-complete.jar" />
  </ItemGroup>

  <!-- Generated/ is a BUILD OUTPUT (.gitignored, never checked in): ANTLR generates DIRECTLY into it
       (DEVLOG 555/556 — each grammar runs from its own directory with a bare filename, the portable fix for
       ANTLR's separator-keyed output mirroring; the parser's -lib inputs stage under obj/antlr-lib/). A fresh
       checkout regenerates, so java + pwsh are build prerequisites on every platform, and a failed generation
       FAILS the build (no stale-parser fallback — the DEVLOG-554 CI break). -->

  <!-- Ensure Generated folder exists and regenerate parser if needed.
       Uses BeforeTargets="CoreCompile" so generation completes before csc runs.
       After generation, explicitly add generated .cs files to the Compile item group
       in case they were missing during initial SDK globbing (e.g., after dotnet clean). -->
  <Target Name="EnsureGeneratedFiles"
          BeforeTargets="CoreCompile"
          Inputs="Grammar/CobolParserCore.g4;Grammar/Core/*.g4"
          Outputs="Generated/CobolLexer.cs;Generated/CobolParserCore.cs">

    <Message Text="Parser files not found. Generating..." Importance="high"
             Condition="!Exists('Generated/CobolParserCore.cs')" />
    <Message Text="Grammar file is newer than parser. Regenerating..." Importance="high"
             Condition="Exists('Generated/CobolParserCore.cs')" />

    <!-- Create Generated folder if it doesn't exist -->
    <MakeDir Directories="$(MSBuildProjectDirectory)/Generated" Condition="!Exists('$(MSBuildProjectDirectory)/Generated')" />

    <!-- Run parser generation (outputs to temp, copies to Generated, skips CobolParserCoreBase.cs).
         A nonzero exit FAILS the build - GenerateIfNewer.ps1 propagates the generator's exit code. -->
    <Exec Command="pwsh -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/GenerateIfNewer.ps1&quot; -PackageName $(AntlrNamespace)"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <!-- Add generated files to compilation in case they were missing during initial globbing -->
    <ItemGroup>
      <Compile Include="Generated\*.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <!-- Clean target: remove generated files AND temp folder -->
  <Target Name="CleanGenerated" AfterTargets="Clean">
    <ItemGroup>
      <GeneratedFiles Include="$(MSBuildProjectDirectory)/Generated/*.*" />
    </ItemGroup>
    <Delete Files="@(GeneratedFiles)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)/Generated" ContinueOnError="true" />
  </Target>

</Project>
