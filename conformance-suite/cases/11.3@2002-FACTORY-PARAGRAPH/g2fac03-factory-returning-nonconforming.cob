      *>--- conformance-case
      *> id: g2fac03-factory-returning-nonconforming
      *> rules: [2002-SR-11.3.2-2]
      *> source-format: fixed
      *> portable: unverified
      *>---
      *> §2002:11.3.2 SR2 - refused: the G2F3XI prototype GETV has a
      *> RETURNING phrase and G2F3XC's factory GETV has none;
      *> §2002:9.3.7.1.2 rule 4: 'The presence or absence of the
      *> procedure division RETURNING phrase is the same in the
      *> corresponding methods'.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. G2F3X01.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       REPOSITORY.
           CLASS G2F3XC
           INTERFACE G2F3XI.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 S USAGE OBJECT REFERENCE G2F3XI.
       01 N PIC 9(4) VALUE 42.
       01 V PIC 99 VALUE 0.
       PROCEDURE DIVISION.
       MAIN-P.
           SET S TO G2F3XC.
           INVOKE S "SPEAK" USING N.
           INVOKE S "GETV" RETURNING V.
           DISPLAY "GOT " V.
           INVOKE S "HELLO".
           STOP RUN.
       END PROGRAM G2F3X01.

       IDENTIFICATION DIVISION.
       INTERFACE-ID. G2F3XI.
       PROCEDURE DIVISION.
       IDENTIFICATION DIVISION.
       METHOD-ID. SPEAK.
       DATA DIVISION.
       LINKAGE SECTION.
       01 P PIC 9(4).
       PROCEDURE DIVISION USING P.
       END METHOD SPEAK.
       IDENTIFICATION DIVISION.
       METHOD-ID. GETV.
       DATA DIVISION.
       LINKAGE SECTION.
       01 R PIC 99.
       PROCEDURE DIVISION RETURNING R.
       END METHOD GETV.
       IDENTIFICATION DIVISION.
       METHOD-ID. HELLO.
       PROCEDURE DIVISION.
       END METHOD HELLO.
       END INTERFACE G2F3XI.

       IDENTIFICATION DIVISION.
       CLASS-ID. G2F3XB INHERITS FROM BASE.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       REPOSITORY.
           CLASS BASE.
       IDENTIFICATION DIVISION.
       FACTORY.
       PROCEDURE DIVISION.
       IDENTIFICATION DIVISION.
       METHOD-ID. HELLO.
       PROCEDURE DIVISION.
           DISPLAY "BASE HELLO".
       END METHOD HELLO.
       END FACTORY.
       END CLASS G2F3XB.

       IDENTIFICATION DIVISION.
       CLASS-ID. G2F3XC INHERITS FROM G2F3XB.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       REPOSITORY.
           CLASS G2F3XB
           INTERFACE G2F3XI.
       IDENTIFICATION DIVISION.
       FACTORY. IMPLEMENTS G2F3XI.
       PROCEDURE DIVISION.
       IDENTIFICATION DIVISION.
       METHOD-ID. SPEAK.
       DATA DIVISION.
       LINKAGE SECTION.
       01 P PIC 9(4).
       PROCEDURE DIVISION USING P.
           DISPLAY "FAC SPEAK " P.
       END METHOD SPEAK.
       IDENTIFICATION DIVISION.
       METHOD-ID. GETV.
       PROCEDURE DIVISION.
           DISPLAY "NO RETURN".
       END METHOD GETV.
       END FACTORY.
       END CLASS G2F3XC.
