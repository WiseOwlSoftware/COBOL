F1 STRING UPPER-CASE(WX(1:L)) INTO T(I)
  EC-BOUND-REF-MOD
F2 STRING UPPER-CASE(LK-X(1:L)) INTO T(I)
  EC-BOUND-REF-MOD
F3 STRING LK-X(1:L) INTO T(I)
  EC-BOUND-REF-MOD
F4 STRING UPPER-CASE(WX)(1:L) INTO T(I)
  EC-BOUND-REF-MOD
F5 STRING LK-X DELIMITED BY UPPER-CASE(LK-X(1:L))
  EC-BOUND-REF-MOD
F6 STRING XY UPPER-CASE(LK-X(1:L)) INTO WR
  EC-BOUND-REF-MOD
  WR=[........]
F7 STRING XY UPPER-CASE(WX)(1:L) INTO WR
  EC-BOUND-REF-MOD
  WR=[........]
V [ABC ] [xABC]