M1 MOVE X(1:L) TO T(I)
  EC-BOUND-REF-MOD
M2 MOVE T(I) TO X(1:L)
  EC-BOUND-SUBSCRIPT
M3 MOVE T(I) TO X(Z:1)
  EC-BOUND-SUBSCRIPT
M4 MOVE X(1:L) TO N(I)
  EC-BOUND-REF-MOD
M5 MOVE X(1:L) TO G(I)
  EC-BOUND-REF-MOD
A1 COMPUTE N(I) = NUMVAL(X(1:L))
  EC-BOUND-REF-MOD
A2 ADD NUMVAL(X(1:L)) TO N(I)
  EC-BOUND-REF-MOD
A3 DIVIDE NUMVAL(X(1:L)) INTO N(I)
  EC-BOUND-REF-MOD
A4 ADD NUMVAL(X(1:L)) TO W GIVING N(I)
  EC-BOUND-REF-MOD
S1 STRING X(1:L) INTO T(I)
  EC-BOUND-REF-MOD
S2 STRING X DELIMITED BY X(1:L) INTO T(I)
  EC-BOUND-REF-MOD
I1 INITIALIZE T(I) REPLACING BY X(1:L)
  EC-BOUND-SUBSCRIPT
E1 EVALUATE V WHEN Z THRU A WHEN T(I)
  EC-RANGE-INVALID
  EC-BOUND-SUBSCRIPT
V [ABC ] [CD  ] [123 ] 0157 0013
END
