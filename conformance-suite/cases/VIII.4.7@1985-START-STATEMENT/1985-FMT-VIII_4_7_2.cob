000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. STRT85.
000300 ENVIRONMENT DIVISION.
000400 INPUT-OUTPUT SECTION.
000500 FILE-CONTROL.
000600     SELECT REL-FILE ASSIGN TO "RELFILE"
000700         ORGANIZATION IS RELATIVE
000800         ACCESS MODE IS DYNAMIC
000900         RELATIVE KEY IS REL-KEY.
001000 DATA DIVISION.
001100 FILE SECTION.
001200 FD  REL-FILE
001300     LABEL RECORDS ARE STANDARD.
001400 01  REL-REC PIC X(4).
001500 WORKING-STORAGE SECTION.
001600 01  REL-KEY PIC 9(4).
001700 PROCEDURE DIVISION.
001800 MAIN-PARA.
001900     OPEN OUTPUT REL-FILE
002000     MOVE 1 TO REL-KEY
002100     MOVE "REC1" TO REL-REC
002200     WRITE REL-REC INVALID KEY DISPLAY "W1 FAIL" END-WRITE
002300     MOVE 2 TO REL-KEY
002400     MOVE "REC2" TO REL-REC
002500     WRITE REL-REC INVALID KEY DISPLAY "W2 FAIL" END-WRITE
002600     MOVE 3 TO REL-KEY
002700     MOVE "REC3" TO REL-REC
002800     WRITE REL-REC INVALID KEY DISPLAY "W3 FAIL" END-WRITE
002900     CLOSE REL-FILE
003000     OPEN INPUT REL-FILE
003100     MOVE 2 TO REL-KEY
003200     START REL-FILE KEY IS >= REL-KEY
003300         INVALID KEY DISPLAY "START FAIL"
003400         NOT INVALID KEY DISPLAY "START OK"
003500     END-START
003600     READ REL-FILE NEXT RECORD
003700         AT END DISPLAY "EOF"
003800         NOT AT END DISPLAY REL-REC
003900     END-READ
004000     MOVE 9 TO REL-KEY
004100     START REL-FILE KEY IS GREATER THAN REL-KEY
004200         INVALID KEY DISPLAY "NO KEY"
004300         NOT INVALID KEY DISPLAY "BAD"
004400     END-START
004500     CLOSE REL-FILE
004600     STOP RUN.
