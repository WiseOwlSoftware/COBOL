           DISPLAY "R4 FRACP NE   " R4
           COMPUTE R4 ROUNDED MODE NEAREST-TOWARD-ZERO = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R4 FRACP NTZ  " R4
           COMPUTE R4 ROUNDED MODE TOWARD-GREATER = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R4 FRACP TG   " R4
           COMPUTE R4 ROUNDED MODE TOWARD-LESSER = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R4 FRACP TL   " R4
           COMPUTE R4 ROUNDED MODE TRUNCATION = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R4 FRACP TRUN " R4
           COMPUTE R4 = FUNCTION FRACTION-PART(FNEG)
           DISPLAY "R4 FRACM NONE " R4
           COMPUTE R4 ROUNDED = FUNCTION FRACTION-PART(FNEG)
           DISPLAY "R4 FRACM RND  " R4
           COMPUTE R4 ROUNDED MODE AWAY-FROM-ZERO = FUNCTION FRACTION-PART(FNEG)
           DISPLAY "R4 FRACM AFZ  " R4
