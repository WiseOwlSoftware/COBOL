           DISPLAY "RP RANDM TL   " RP
           COMPUTE RP ROUNDED MODE TRUNCATION = FUNCTION RANDOM(97090)
           DISPLAY "RP RANDM TRUN " RP
           COMPUTE RP = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "RP FRACP NONE " RP
           COMPUTE RP ROUNDED = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "RP FRACP RND  " RP
           COMPUTE RP ROUNDED MODE AWAY-FROM-ZERO = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "RP FRACP AFZ  " RP
