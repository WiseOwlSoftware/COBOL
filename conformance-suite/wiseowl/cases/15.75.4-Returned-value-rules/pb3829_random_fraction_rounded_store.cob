           DISPLAY "R2 RANDM NTZ  " R2
           COMPUTE R2 ROUNDED MODE TOWARD-GREATER = FUNCTION RANDOM(97090)
           DISPLAY "R2 RANDM TG   " R2
           COMPUTE R2 ROUNDED MODE TOWARD-LESSER = FUNCTION RANDOM(97090)
           DISPLAY "R2 RANDM TL   " R2
           COMPUTE R2 ROUNDED MODE TRUNCATION = FUNCTION RANDOM(97090)
           DISPLAY "R2 RANDM TRUN " R2
           COMPUTE R2 = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R2 FRACP NONE " R2
           COMPUTE R2 ROUNDED = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R2 FRACP RND  " R2
           COMPUTE R2 ROUNDED MODE AWAY-FROM-ZERO = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R2 FRACP AFZ  " R2
           COMPUTE R2 ROUNDED MODE NEAREST-AWAY-FROM-ZERO = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R2 FRACP NAFZ " R2
           COMPUTE R2 ROUNDED MODE NEAREST-EVEN = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R2 FRACP NE   " R2
           COMPUTE R2 ROUNDED MODE NEAREST-TOWARD-ZERO = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R2 FRACP NTZ  " R2
           COMPUTE R2 ROUNDED MODE TOWARD-GREATER = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R2 FRACP TG   " R2
           COMPUTE R2 ROUNDED MODE TOWARD-LESSER = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R2 FRACP TL   " R2
           COMPUTE R2 ROUNDED MODE TRUNCATION = FUNCTION FRACTION-PART(FSRC)
           DISPLAY "R2 FRACP TRUN " R2
           COMPUTE R2 = FUNCTION FRACTION-PART(FNEG)
           DISPLAY "R2 FRACM NONE " R2
           COMPUTE R2 ROUNDED = FUNCTION FRACTION-PART(FNEG)
           DISPLAY "R2 FRACM RND  " R2
           COMPUTE R2 ROUNDED MODE AWAY-FROM-ZERO = FUNCTION FRACTION-PART(FNEG)
           DISPLAY "R2 FRACM AFZ  " R2
