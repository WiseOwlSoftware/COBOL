           DISPLAY "R4 FRACM TG   " R4
           COMPUTE R4 ROUNDED MODE TOWARD-LESSER = FUNCTION FRACTION-PART(FNEG)
           DISPLAY "R4 FRACM TL   " R4
           COMPUTE R4 ROUNDED MODE TRUNCATION = FUNCTION FRACTION-PART(FNEG)
           DISPLAY "R4 FRACM TRUN " R4
           COMPUTE R2 = FUNCTION RANDOM(97090)
           DISPLAY "R2 RANDM NONE " R2
           COMPUTE R2 ROUNDED = FUNCTION RANDOM(97090)
           DISPLAY "R2 RANDM RND  " R2
           COMPUTE R2 ROUNDED MODE AWAY-FROM-ZERO = FUNCTION RANDOM(97090)
           DISPLAY "R2 RANDM AFZ  " R2
           COMPUTE R2 ROUNDED MODE NEAREST-AWAY-FROM-ZERO = FUNCTION RANDOM(97090)
           DISPLAY "R2 RANDM NAFZ " R2
