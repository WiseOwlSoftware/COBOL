<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Copyright>Copyright (c) 2026 Brent Rector</Copyright>
    <Authors>Brent Rector</Authors>
    <!-- kb/Work PB3146: every package carries the repository's LICENSE (the Business Source License 1.1 with its
         parameters) as a file. nuget.org takes a license EXPRESSION only for an OSI- or FSF-approved license, and a
         bare SPDX id would drop the parameters (the Additional Use Grant, the Change Date and the Change License). -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <!-- THE PRODUCT VERSION (kb/Work PB2097; docs/rearchitecture/DESIGN-external-repository.md §15.4): the package
         version, and so every assembly's AssemblyVersion. The runtime's MAJOR is a contract: every compiled COBOL module
         records the runtime version it was compiled against ([assembly: CobolRepository], __CobolModule.EnsureRegistered),
         and a run unit refuses a module of another major (RuntimeAbi.Skew). Raise the major exactly when the runtime's
         public surface (src/WiseOwl.Cobol.Runtime/PublicAPI.Shipped.txt) or a codec's image layout changes incompatibly;
         RuntimeAbiPinDriftTests pins it beside the surface's hash in src/WiseOwl.Cobol.Runtime/RuntimeAbi.pin, a file
         scripts/abi_pin.py writes (its bump command raises this number and measures; kb/Work PB3610). -->
    <Version>28.0.0</Version>
  </PropertyGroup>
  <!-- The LICENSE file PackageLicenseFile names, packed at the package root. Items are evaluated after every property,
       so the project's own IsPackable (false in every test and tool project) is already set here. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
  <!-- THE PUBLISHED CONFORMANCE STATEMENT (kb/Work PB5431; DESIGN-orchestrator-loop.md section 16.8, step C). The
       §2023:4.2.16 user documentation is the conformance statement, whose sources are docs/conformance/ (one file per
       entry) and whose whole, docs/CONFORMANCE.md, is a gitignored view. Every package renders it at pack time and
       carries it at docs/CONFORMANCE.md beside LICENSE, so the compiler and CLI messages that name that path name a file
       every user installed. The render is the checkout's (scripts/spec/conformance_doc.py, the one renderer), and a
       source out of shape fails the render and so the pack: a package never ships without its statement. Only a pack
       runs the target (a project that is not packable is never packed). -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CobolPackConformanceStatement</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="CobolPackConformanceStatement">
    <PropertyGroup>
      <CobolConformanceStatement>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)CONFORMANCE.md</CobolConformanceStatement>
    </PropertyGroup>
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)scripts/spec/conformance_doc.py&quot; --out &quot;$(CobolConformanceStatement)&quot;"
          StdOutEncoding="utf-8" StdErrEncoding="utf-8" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(CobolConformanceStatement)" PackagePath="docs/CONFORMANCE.md" />
    </ItemGroup>
  </Target>
  <!-- kb/Work PB985 (DESIGN-test-build-ci §3.12): a DEBUG build's bits must depend on its SOURCES, not on the commit
       it was built at. The SDK queries git and stamps the commit into AssemblyInformationalVersion ("1.0.0+<sha>")
       and into the Source Link map the PDB carries (whose checksum the assembly embeds), so every commit changed
       every assembly - the compiled-program cache keys on the compiler's bits and missed on every
       case of every re-gate that followed a commit, and every incremental build recompiled every project. Release
       (the shipped build) keeps the stamp; nothing reads it in Debug.
       ⛔ An EMPTY Configuration is Debug here: this file is imported BEFORE Microsoft.Common.props defaults
       Configuration, so a project built on its own without -c (every CI build step) sees '' - only a solution
       build passes Configuration=Debug as a global property. Keyed on 'Debug' alone, CI still stamped the
       commit (train 52's first CI run, CompiledProgramCacheDriftTests.ADebugBuild_DoesNotStampTheCommit). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == ''">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- kb/Work PB2528 (owner decision 2026-10-07; DESIGN-test-build-ci §3.16): the platforms the WiseOwl COBOL runtime
       is precompiled ReadyToRun for. src/WiseOwl.Cobol.Runtime builds one image per entry and every project that
       references it carries them at ReadyToRun/<rid>/WiseOwl.Cobol.Runtime.dll; the CLI's publish (what the
       WiseOwl.COBOL tool package packs) refuses to finish without every one; ReadyToRunRuntimeDriftTests requires
       the platform each CI leg runs on. Adding a platform is one entry here. -->
  <PropertyGroup>
    <CobolRuntimeReadyToRunIdentifiers>win-x64;linux-x64</CobolRuntimeReadyToRunIdentifiers>
  </PropertyGroup>
</Project>
