<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Copyright>Copyright (c) 2026 Brent Rector</Copyright>
    <Authors>Brent Rector</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <!-- kb/Work PB985 (DESIGN-test-build-ci §3.12): a DEBUG build's bits must depend on its SOURCES, not on the commit
       it was built at. The SDK queries git and stamps the commit into AssemblyInformationalVersion ("1.0.0+<sha>")
       and into the Source Link map the PDB carries (whose checksum the assembly embeds), so every commit changed
       every assembly - the compiled-program cache keys on the compiler's bits and missed on every
       case of every re-gate that followed a commit, and every incremental build recompiled every project. Release
       (the shipped build) keeps the stamp; nothing reads it in Debug.
       ⛔ An EMPTY Configuration is Debug here: this file is imported BEFORE Microsoft.Common.props defaults
       Configuration, so a project built on its own without -c (every CI build step) sees '' - only a solution
       build passes Configuration=Debug as a global property. Keyed on 'Debug' alone, CI still stamped the
       commit (train 52's first CI run, CompiledProgramCacheDriftTests.ADebugBuild_DoesNotStampTheCommit). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == ''">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- kb/Work PB2528 (owner decision 2026-10-07; DESIGN-test-build-ci §3.16): the platforms the WiseOwl COBOL runtime
       is precompiled ReadyToRun for. src/Cobol.Net.Runtime builds one image per entry and every project that
       references it carries them at ReadyToRun/<rid>/Cobol.Net.Runtime.dll; the CLI's publish (what the
       WiseOwl.COBOL tool package packs) refuses to finish without every one; ReadyToRunRuntimeDriftTests requires
       the platform each CI leg runs on. Adding a platform is one entry here. -->
  <PropertyGroup>
    <CobolRuntimeReadyToRunIdentifiers>win-x64;linux-x64</CobolRuntimeReadyToRunIdentifiers>
  </PropertyGroup>
</Project>
