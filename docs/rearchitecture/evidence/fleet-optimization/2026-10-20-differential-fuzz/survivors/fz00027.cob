       IDENTIFICATION DIVISION.
       PROGRAM-ID. FUZZ.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-A    PIC S9(5)V99 VALUE 12345.67.
       01  WS-B    PIC S9(5)V99 VALUE 87654.32.
       01  WS-RESULT PIC S9(6)V99.
       01  WS-PRODUCT PIC S9(10)V99.
       01  WS-QUOTIENT PIC S9(7)V99.
       PROCEDURE DIVISION.
           ADD WS-A TO WS-B GIVING WS-RESULT.
           DISPLAY 'ADD: ' WS-RESULT.
           SUBTRACT WS-B FROM WS-A GIVING WS-RESULT.
           DISPLAY 'SUBTRACT: ' WS-RESULT.
           MULTIPLY WS-A BY WS-B GIVING WS-PRODUCT.
           DISPLAY 'MULTIPLY: ' WS-PRODUCT.
           DIVIDE WS-A BY WS-B GIVING WS-QUOTIENT.
           DISPLAY 'DIVIDE: ' WS-QUOTIENT.
           COMPUTE WS-RESULT = WS-A + WS-B.
           DISPLAY 'COMPUTE ADD: ' WS-RESULT.
           COMPUTE WS-RESULT = WS-A - WS-B.
           DISPLAY 'COMPUTE SUBTRACT: ' WS-RESULT.
           COMPUTE WS-PRODUCT = WS-A * WS-B.
           DISPLAY 'COMPUTE MULTIPLY: ' WS-PRODUCT.
           COMPUTE WS-QUOTIENT = WS-A / WS-B.
           DISPLAY 'COMPUTE DIVIDE: ' WS-QUOTIENT.
           COMPUTE WS-RESULT = -WS-A.
           DISPLAY 'UNARY MINUS: ' WS-RESULT.
           COMPUTE WS-RESULT = +WS-A.
           DISPLAY 'UNARY PLUS: ' WS-RESULT.
           COMPUTE WS-RESULT = WS-A * WS-B / WS-A.
           DISPLAY 'COMPLEX: ' WS-RESULT.
           COMPUTE WS-RESULT = (WS-A + WS-B) - WS-A.
           DISPLAY 'PARENTHESES: ' WS-RESULT.
           STOP RUN.
