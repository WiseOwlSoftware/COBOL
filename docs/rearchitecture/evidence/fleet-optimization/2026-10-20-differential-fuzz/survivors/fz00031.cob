       IDENTIFICATION DIVISION.
       PROGRAM-ID. FUZZ.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. GENERIC-COMPUTER.
       OBJECT-COMPUTER. GENERIC-COMPUTER.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-OPERAND-1    PIC 9(5)V99 VALUE 2.5.
       01 WS-OPERAND-2    PIC 9(5)V99 VALUE 3.0.
       01 WS-RESULT       PIC 9(10)V99.
       01 WS-TEST-CASE    PIC 9 VALUE 1.
       01 WS-TEMP         PIC 9(10)V99.
       01 WS-ZERO         PIC 9(5)V99 VALUE 0.0.
       01 WS-NEG-ONE      PIC S9(4)V99 VALUE -1.0.
       01 WS-NEG-TWO      PIC S9(4)V99 VALUE -2.0.
       01 WS-POS-TWO      PIC 9(5)V99 VALUE 2.0.
       01 WS-POS-THREE    PIC 9(5)V99 VALUE 3.0.
       01 WS-NEG-THREE    PIC S9(4)V99 VALUE -3.0.
       01 WS-NEG-FIVE     PIC S9(4)V99 VALUE -5.0.
       01 WS-POS-FIVE     PIC 9(5)V99 VALUE 5.0.
       01 WS-POS-TEN      PIC 9(5)V99 VALUE 10.0.
       01 WS-NEG-TEN      PIC S9(4)V99 VALUE -10.0.
       01 WS-NEG-HALF     PIC S9(4)V99 VALUE -0.5.
       01 WS-POS-HALF     PIC 9(5)V99 VALUE 0.5.
       01 WS-NEG-ONE-THIRD PIC S9(4)V99 VALUE -0.333.
       01 WS-POS-ONE-THIRD PIC 9(5)V99 VALUE 0.333.
       01 WS-NEG-FOUR     PIC S9(4)V99 VALUE -4.0.
       01 WS-POS-FOUR     PIC 9(5)V99 VALUE 4.0.
       01 WS-NEG-EIGHT    PIC S9(4)V99 VALUE -8.0.
       01 WS-POS-EIGHT    PIC 9(5)V99 VALUE 8.0.
       01 WS-NEG-TWELVE   PIC S9(4)V99 VALUE -12.0.
       01 WS-POS-TWELVE   PIC 9(5)V99 VALUE 12.0.
       01 WS-NEG-TEN-THOUSAND PIC S9(4)V99 VALUE -10000.0.
       01 WS-POS-TEN-THOUSAND PIC 9(5)V99 VALUE 10000.0.
       01 WS-NEG-ONE-MILLION PIC S9(4)V99 VALUE -1000000.0.
       01 WS-POS-ONE-MILLION PIC 9(5)V99 VALUE 1000000.0.
       PROCEDURE DIVISION.
           DISPLAY "TESTING EXPONENTIATION"
           PERFORM TEST-CASE-1
           PERFORM TEST-CASE-2
           PERFORM TEST-CASE-3
           PERFORM TEST-CASE-4
           PERFORM TEST-CASE-5
           PERFORM TEST-CASE-6
           PERFORM TEST-CASE-7
           PERFORM TEST-CASE-8
           PERFORM TEST-CASE-9
           PERFORM TEST-CASE-10
           STOP RUN.
       TEST-CASE-1.
           MOVE 2.0 TO WS-OPERAND-1
           MOVE 0.0 TO WS-OPERAND-2
           COMPUTE WS-RESULT = WS-OPERAND-1 ** WS-OPERAND-2
           DISPLAY "CASE 1: 2.0 ** 0.0 = " WS-RESULT
           .
       TEST-CASE-2.
           MOVE 5.0 TO WS-OPERAND-1
           MOVE 1.0 TO WS-OPERAND-2
           COMPUTE WS-RESULT = WS-OPERAND-1 ** WS-OPERAND-2
           DISPLAY "CASE 2: 5.0 ** 1.0 = " WS-RESULT
           .
       TEST-CASE-3.
           MOVE 3.0 TO WS-OPERAND-1
           MOVE 2.0 TO WS-OPERAND-2
           COMPUTE WS-RESULT = WS-OPERAND-1 ** WS-OPERAND-2
           DISPLAY "CASE 3: 3.0 ** 2.0 = " WS-RESULT
           .
       TEST-CASE-4.
           MOVE 4.0 TO WS-OPERAND-1
           MOVE 3.0 TO WS-OPERAND-2
           COMPUTE WS-RESULT = WS-OPERAND-1 ** WS-OPERAND-2
           DISPLAY "CASE 4: 4.0 ** 3.0 = " WS-RESULT
           .
       TEST-CASE-5.
           MOVE 2.0 TO WS-OPERAND-1
           MOVE 4.0 TO WS-OPERAND-2
           COMPUTE WS-RESULT = WS-OPERAND-1 ** WS-OPERAND-2
           DISPLAY "CASE 5: 2.0 ** 4.0 = " WS-RESULT
           .
       TEST-CASE-6.
           MOVE 2.0 TO WS-OPERAND-1
           MOVE -1.0 TO WS-OPERAND-2
           COMPUTE WS-RESULT = WS-OPERAND-1 ** WS-OPERAND-2
           DISPLAY "CASE 6: 2.0 ** -1.0 = " WS-RESULT
           .
       TEST-CASE-7.
           MOVE 3.0 TO WS-OPERAND-1
           MOVE -2.0 TO WS-OPERAND-2
           COMPUTE WS-RESULT = WS-OPERAND-1 ** WS-OPERAND-2
           DISPLAY "CASE 7: 3.0 ** -2.0 = " WS-RESULT
           .
       TEST-CASE-8.
           MOVE 5.0 TO WS-OPERAND-1
           MOVE -3.0 TO WS-OPERAND-2
           COMPUTE WS-RESULT = WS-OPERAND-1 ** WS-OPERAND-2
           DISPLAY "CASE 8: 5.0 ** -3.0 = " WS-RESULT
           .
       TEST-CASE-9.
           MOVE -2.0 TO WS-OPERAND-1
           MOVE 2.0 TO WS-OPERAND-2
           COMPUTE WS-RESULT = WS-OPERAND-1 ** WS-OPERAND-2
           DISPLAY "CASE 9: -2.0 ** 2.0 = " WS-RESULT
           .
       TEST-CASE-10.
           MOVE -3.0 TO WS-OPERAND-1
           MOVE 3.0 TO WS-OPERAND-2
           COMPUTE WS-RESULT = WS-OPERAND-1 ** WS-OPERAND-2
           DISPLAY "CASE 10: -3.0 ** 3.0 = " WS-RESULT
           .
