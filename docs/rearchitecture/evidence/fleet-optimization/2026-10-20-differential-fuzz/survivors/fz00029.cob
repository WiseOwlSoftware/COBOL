       IDENTIFICATION DIVISION.
       PROGRAM-ID. FUZZ.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-A PIC 9(5)V99 VALUE 12345.67.
       01 WS-B PIC 9(5)V99 VALUE  1000.00.
       01 WS-C PIC S9(4)V99 VALUE -1234.56.
       01 WS-D PIC S9(4)V99 VALUE -9876.54.
       01 WS-RESULT PIC 9(6)V99.
       01 WS-NEGATIVE PIC S9(6)V99.
       01 WS-POSITIVE PIC S9(6)V99.
       01 WS-ZERO PIC 9(6)V99 VALUE ZERO.
       01 WS-NEG-ZERO PIC S9(6)V99 VALUE ZERO.
       PROCEDURE DIVISION.
           COMPUTE WS-RESULT = WS-A + WS-B
           DISPLAY "ADD: " WS-RESULT
           COMPUTE WS-RESULT = WS-A - WS-B
           DISPLAY "SUB: " WS-RESULT
           COMPUTE WS-RESULT = WS-A * WS-B
           DISPLAY "MUL: " WS-RESULT
           COMPUTE WS-RESULT = WS-A / WS-B
           DISPLAY "DIV: " WS-RESULT
           COMPUTE WS-NEGATIVE = -WS-A
           DISPLAY "NEG: " WS-NEGATIVE
           COMPUTE WS-POSITIVE = +WS-C
           DISPLAY "POS: " WS-POSITIVE
           COMPUTE WS-RESULT = WS-C + WS-D
           DISPLAY "NEG ADD: " WS-RESULT
           COMPUTE WS-RESULT = WS-C - WS-D
           DISPLAY "NEG SUB: " WS-RESULT
           COMPUTE WS-RESULT = WS-C * WS-D
           DISPLAY "NEG MUL: " WS-RESULT
           COMPUTE WS-RESULT = WS-C / WS-D
           DISPLAY "NEG DIV: " WS-RESULT
           STOP RUN.
