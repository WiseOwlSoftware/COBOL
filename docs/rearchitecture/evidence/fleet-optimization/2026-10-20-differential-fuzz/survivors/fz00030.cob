       IDENTIFICATION DIVISION.
       PROGRAM-ID. FUZZ.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. ANY-COMPUTER.
       OBJECT-COMPUTER. ANY-COMPUTER.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-OPERAND-1    PIC S9(5)V99 VALUE 2.5.
       01  WS-OPERAND-2    PIC S9(5)V99 VALUE 3.0.
       01  WS-RESULT       PIC S9(7)V999999 VALUE 0.
       01  WS-TEST-CASE    PIC 9 VALUE 1.
       01  WS-EXCEPTION    PIC X VALUE SPACE.
       01  WS-EXCEPTION-FLAG PIC 9 VALUE 0.
       01  WS-ZERO         PIC S9(5)V99 VALUE 0.0.
       01  WS-NEG-ONE      PIC S9(5)V99 VALUE -1.0.
       01  WS-NEG-TWO      PIC S9(5)V99 VALUE -2.0.
       01  WS-NEG-THREE    PIC S9(5)V99 VALUE -3.0.
       01  WS-ONE          PIC S9(5)V99 VALUE 1.0.
       01  WS-TWO          PIC S9(5)V99 VALUE 2.0.
       01  WS-THREE        PIC S9(5)V99 VALUE 3.0.
       01  WS-FOUR         PIC S9(5)V99 VALUE 4.0.
       01  WS-FIVE         PIC S9(5)V99 VALUE 5.0.
       01  WS-TEN          PIC S9(5)V99 VALUE 10.0.
       01  WS-NEG-TEN      PIC S9(5)V99 VALUE -10.0.
       01  WS-HALF         PIC S9(5)V99 VALUE 0.5.
       01  WS-NEG-HALF     PIC S9(5)V99 VALUE -0.5.
       01  WS-DECIMAL-1    PIC S9(3)V99 VALUE 1.00.
       01  WS-DECIMAL-2    PIC S9(3)V99 VALUE 2.00.
       01  WS-DECIMAL-3    PIC S9(3)V99 VALUE 3.00.
       01  WS-DECIMAL-4    PIC S9(3)V99 VALUE 4.00.
       01  WS-DECIMAL-5    PIC S9(3)V99 VALUE 5.00.
       01  WS-DECIMAL-10   PIC S9(3)V99 VALUE 10.00.
       01  WS-DECIMAL-NEG1 PIC S9(3)V99 VALUE -1.00.
       01  WS-DECIMAL-NEG2 PIC S9(3)V99 VALUE -2.00.
       01  WS-DECIMAL-NEG3 PIC S9(3)V99 VALUE -3.00.
       01  WS-DECIMAL-NEG4 PIC S9(3)V99 VALUE -4.00.
       01  WS-DECIMAL-NEG5 PIC S9(3)V99 VALUE -5.00.
       01  WS-DECIMAL-NEG10 PIC S9(3)V99 VALUE -10.00.
       01  WS-DECIMAL-ZERO PIC S9(3)V99 VALUE 0.00.
       01  WS-DECIMAL-ONE  PIC S9(3)V99 VALUE 1.00.
       PROCEDURE DIVISION.
           DISPLAY "TESTING EXPONENTIATION RULES"
           DISPLAY "============================="
           
           PERFORM TEST-ZERO-TO-POWER
           PERFORM TEST-POSITIVE-INTEGERS
           PERFORM TEST-NEGATIVE-INTEGERS
           PERFORM TEST-FRACTIONS
           PERFORM TEST-EDGE-CASES
           PERFORM TEST-ZERO-TO-ZERO
           
           DISPLAY "END OF TESTS"
           STOP RUN.
       TEST-ZERO-TO-POWER.
           DISPLAY "TEST 1: ZERO TO POWER OF NON-ZERO"
           COMPUTE WS-RESULT = WS-ZERO ** WS-ONE
           DISPLAY "0 ** 1 = " WS-RESULT
           COMPUTE WS-RESULT = WS-ZERO ** WS-TWO
           DISPLAY "0 ** 2 = " WS-RESULT
           COMPUTE WS-RESULT = WS-ZERO ** WS-THREE
           DISPLAY "0 ** 3 = " WS-RESULT
           COMPUTE WS-RESULT = WS-ZERO ** WS-NEG-ONE
           DISPLAY "0 ** -1 = " WS-RESULT
           COMPUTE WS-RESULT = WS-ZERO ** WS-NEG-TWO
           DISPLAY "0 ** -2 = " WS-RESULT
           COMPUTE WS-RESULT = WS-ZERO ** WS-HALF
           DISPLAY "0 ** 0.5 = " WS-RESULT
           COMPUTE WS-RESULT = WS-ZERO ** WS-NEG-HALF
           DISPLAY "0 ** -0.5 = " WS-RESULT.
       TEST-POSITIVE-INTEGERS.
           DISPLAY "TEST 2: POSITIVE INTEGER EXPONENTS"
           COMPUTE WS-RESULT = WS-TWO ** WS-ONE
           DISPLAY "2 ** 1 = " WS-RESULT
           COMPUTE WS-RESULT = WS-TWO ** WS-TWO
           DISPLAY "2 ** 2 = " WS-RESULT
           COMPUTE WS-RESULT = WS-TWO ** WS-THREE
           DISPLAY "2 ** 3 = " WS-RESULT
           COMPUTE WS-RESULT = WS-TWO ** WS-FOUR
           DISPLAY "2 ** 4 = " WS-RESULT
           COMPUTE WS-RESULT = WS-TEN ** WS-ONE
           DISPLAY "10 ** 1 = " WS-RESULT
           COMPUTE WS-RESULT = WS-TEN ** WS-TWO
           DISPLAY "10 ** 2 = " WS-RESULT.
       TEST-NEGATIVE-INTEGERS.
           DISPLAY "TEST 3: NEGATIVE INTEGER EXPONENTS"
           COMPUTE WS-RESULT = WS-TWO ** WS-NEG-ONE
           DISPLAY "2 ** -1 = " WS-RESULT
           COMPUTE WS-RESULT = WS-TWO ** WS-NEG-TWO
           DISPLAY "2 ** -2 = " WS-RESULT
           COMPUTE WS-RESULT = WS-TEN ** WS-NEG-ONE
           DISPLAY "10 ** -1 = " WS-RESULT
           COMPUTE WS-RESULT = WS-TEN ** WS-NEG-TWO
           DISPLAY "10 ** -2 = " WS-RESULT.
       TEST-FRACTIONS.
           DISPLAY "TEST 4: FRACTIONAL EXPONENTS"
           COMPUTE WS-RESULT = WS-FOUR ** WS-HALF
           DISPLAY "4 ** 0.5 = " WS-RESULT
           COMPUTE WS-RESULT = WS-TWO ** WS-HALF
           DISPLAY "2 ** 0.5 = " WS-RESULT
           COMPUTE WS-RESULT = WS-TWO ** WS-NEG-HALF
           DISPLAY "2 ** -0.5 = " WS-RESULT.
       TEST-EDGE-CASES.
           DISPLAY "TEST 5: EDGE CASES"
           COMPUTE WS-RESULT = WS-ONE ** WS-ONE
           DISPLAY "1 ** 1 = " WS-RESULT
           COMPUTE WS-RESULT = WS-ONE ** WS-TWO
           DISPLAY "1 ** 2 = " WS-RESULT
           COMPUTE WS-RESULT = WS-NEG-ONE ** WS-ONE
           DISPLAY "-1 ** 1 = " WS-RESULT
           COMPUTE WS-RESULT = WS-NEG-ONE ** WS-TWO
           DISPLAY "-1 ** 2 = " WS-RESULT
           COMPUTE WS-RESULT = WS-NEG-ONE ** WS-THREE
           DISPLAY "-1 ** 3 = " WS-RESULT.
       TEST-ZERO-TO-ZERO.
           DISPLAY "TEST 6: ZERO TO POWER OF ZERO"
           COMPUTE WS-RESULT = WS-ZERO ** WS-ZERO
           DISPLAY "0 ** 0 = " WS-RESULT
           DISPLAY "END OF EXPONENTIATION TESTS".
