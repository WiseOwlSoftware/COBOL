       IDENTIFICATION DIVISION.
       PROGRAM-ID. FUZZ.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-A        PIC S9(3)V99 VALUE 123.45.
       01 WS-B        PIC S9(3)V99 VALUE 678.90.
       01 WS-C        PIC S9(3)V99 VALUE -123.45.
       01 WS-D        PIC S9(3)V99 VALUE -678.90.
       01 WS-RESULT   PIC S9(4)V99.
       01 WS-TEMP     PIC 9(4)V99.
       01 WS-ZERO     PIC S9(4)V99 VALUE ZERO.
       01 WS-NEG-ONE  PIC S9(4)V99 VALUE -1.00.
       01 WS-ONE      PIC S9(4)V99 VALUE 1.00.
       01 WS-MAX      PIC S9(3)V99 VALUE 999.99.
       01 WS-MIN      PIC S9(3)V99 VALUE -999.99.
       PROCEDURE DIVISION.
           ADD WS-A TO WS-B GIVING WS-RESULT.
           DISPLAY "ADD: " WS-RESULT.
           SUBTRACT WS-A FROM WS-B GIVING WS-RESULT.
           DISPLAY "SUB: " WS-RESULT.
           MULTIPLY WS-A BY WS-B GIVING WS-RESULT.
           DISPLAY "MUL: " WS-RESULT.
           DIVIDE WS-B BY WS-A GIVING WS-RESULT.
           DISPLAY "DIV: " WS-RESULT.
           COMPUTE WS-RESULT = WS-A + WS-B.
           DISPLAY "COMP ADD: " WS-RESULT.
           COMPUTE WS-RESULT = WS-A - WS-B.
           DISPLAY "COMP SUB: " WS-RESULT.
           COMPUTE WS-RESULT = WS-A * WS-B.
           DISPLAY "COMP MUL: " WS-RESULT.
           COMPUTE WS-RESULT = WS-B / WS-A.
           DISPLAY "COMP DIV: " WS-RESULT.
           COMPUTE WS-RESULT = -WS-A.
           DISPLAY "NEG: " WS-RESULT.
           COMPUTE WS-RESULT = +WS-A.
           DISPLAY "POS: " WS-RESULT.
           STOP RUN.
