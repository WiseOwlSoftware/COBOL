{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet clean:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(pwsh -NoProfile -File scripts/session-probe.ps1)",
      "Bash(python scripts/render-spec-page.py:*)",
      "Bash(python scripts/gnucobol_differential.py:*)"
    ],
    "additionalDirectories": [
      "\\tmp",
      "e:\\tmp",
      "C:\\Users\\brent\\AppData\\Local\\Temp"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python E:/CobolSharp/scripts/hooks/session_start.py",
            "timeout": 120,
            "statusMessage": "Probing live state..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python E:/CobolSharp/scripts/hooks/devlog_staged.py",
            "if": "Bash(git commit*)",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python E:/CobolSharp/scripts/hooks/golden_registered.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python E:/CobolSharp/scripts/hooks/unpushed.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
