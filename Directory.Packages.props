<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiler dependencies -->
    <PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <!-- COBOL.NET (greenfield) backend: Roslyn for runtime C# code generation + compilation -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- CLI argument parsing: Microsoft's first-party parser (the one the dotnet CLI uses) — correct
         inline-value and space-separated handling, arity, and auto-generated help (Cobol.Net.Cli). -->
    <PackageVersion Include="System.CommandLine" Version="2.0.9" />

    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />

    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
