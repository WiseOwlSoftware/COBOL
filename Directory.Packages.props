<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiler dependencies -->
    <PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <!-- WiseOwl COBOL (greenfield) backend: Roslyn for runtime C# code generation + compilation -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- CLI argument parsing: Microsoft's first-party parser (the one the dotnet CLI uses) — correct
         inline-value and space-separated handling, arity, and auto-generated help (Cobol.Net.Cli). -->
    <PackageVersion Include="System.CommandLine" Version="2.0.9" />
    <!-- The runtime's public surface is a recorded contract (kb/Work PB2097; DESIGN-external-repository §15.4):
         src/Cobol.Net.Runtime/PublicAPI.Shipped.txt lists it, and RS0016/RS0017 make every change to it a deliberate,
         reviewed edit of that file. 5.0.0 is the Roslyn the .NET 10.0.100 SDK band (global.json) carries, so the analyzer
         never needs a newer compiler than the build has. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.0.0" />

    <!-- The architecture census's Roslyn host (tools/ArchCensus; kb/Work PB2115): it loads Cobol.Net.sln through
         MSBuildWorkspace. The host's Roslyn packages share ONE version among themselves, and it need not be the
         product compiler's (a measuring tool ships nothing): 5.0.0 because 4.14's MSBuild workspace pulls
         Microsoft.Build.Tasks.Core 17.7.2, a known high-severity advisory (NU1903, an error here), and 5.0.0
         depends on Microsoft.Build.Framework alone. MSBuildLocator registers the SDK's MSBuild before any workspace
         call. Never part of Cobol.Net.sln. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.9.1" />

    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />

    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
