filters:
  and:
    - file.inFolder("kb/Fixes")
    - id != null
formulas:
  harm: 'if(wrong_answer, "wrong answer", if(crashes, "crash", if(rejects_legal_source, "rejects legal source", if(under_rejects, "under-rejects", "process"))))'
  actionable: 'status != "landed" and (wrong_answer or crashes) and !blocked'
properties:
  note.id:
    displayName: Item
  note.severity:
    displayName: Severity
  note.area:
    displayName: Area
  note.status:
    displayName: Status
  note.wrong_answer:
    displayName: Wrong answer
  note.crashes:
    displayName: Crashes
  note.silent:
    displayName: Silent
  note.blocked:
    displayName: Blocked
  formula.harm:
    displayName: Harm
views:
  # ⛔ THE ONLY VIEW THAT DECIDES WHAT TO WORK ON. Ranked by what the defect DOES to a user's program, never by
  # its severity label: PB24 (FUNCTION LENGTH silently wrong) and PB39 (rule-id numbering, zero wrong answers)
  # are BOTH [MAJOR], and on 2026-08-04 the session picked PB39. This filter drops PB39 off the list entirely.
  - type: table
    name: Fix next
    filters:
      and:
        - status != "landed"
        - wrong_answer or crashes
        - 'blocked == false'
    order:
      - id
      - severity
      - area
      - harm
      - silent
    sort:
      - property: severity
        direction: ASC
      - property: id
        direction: ASC
  - type: table
    name: Blocked
    filters:
      and:
        - status != "landed"
        - 'blocked == true'
    order:
      - id
      - severity
      - area
      - blocked_by
      - harm
  # Real work that produces no wrong answer — kept visible so it is DEFERRED on purpose rather than forgotten.
  - type: table
    name: Open but nobody gets a wrong answer
    filters:
      and:
        - status != "landed"
        - 'wrong_answer == false'
        - 'crashes == false'
    order:
      - id
      - severity
      - area
      - harm
    sort:
      - property: severity
        direction: ASC
  - type: table
    name: All items by status
    order:
      - id
      - status
      - severity
      - area
      - harm
    sort:
      - property: status
        direction: ASC
      - property: id
        direction: ASC
