filters:
  and:
    - file.inFolder("kb/Work")
    - id != null
formulas:
  # ⛔ BLOCKED IS DERIVED, NEVER STORED (kb/Work PB3389), THE SAME RULE AS work.py's `waiting_on`, WRITTEN IN A SECOND
  # LANGUAGE BECAUSE IT MUST BE: a note waits while a `blocked_by` note is not landed or retired (a blocker the vault lacks
  # counts as open) and is held while its status is owner or blocked. `work.py check` asserts this formula names every
  # terminal status, so the next one added to TERMINAL_STATUSES is not forgotten here. The status of a blocker is read
  # through `link(value).asFile().properties`, a Bases expression that `work.py` cannot run: `work.py next` is the
  # authoritative list, and this view agrees with it or is wrong.
  blocked: 'if(status == "owner" || status == "blocked", true, if(blocked_by, blocked_by.filter(link(value).asFile().properties.status != "landed" && link(value).asFile().properties.status != "retired").length > 0, false))'
  harm: 'if(wrong_answer, "wrong answer", if(crashes, "crash", if(rejects_legal_source, "rejects legal source", if(under_rejects, "under-rejects", "process"))))'
properties:
  note.id:
    displayName: Item
  note.kind:
    displayName: Kind
  note.status:
    displayName: Status
  note.severity:
    displayName: Severity
  note.area:
    displayName: Area
  note.wrong_answer:
    displayName: Wrong answer
  note.crashes:
    displayName: Crashes
  note.silent:
    displayName: Silent
  formula.blocked:
    displayName: Blocked
  note.inventory_rows:
    displayName: Claims rows
  # ⭐ The back-link a landing writes (owner decision 2026-09-19, kb/Work/PB245): the inventory rows the fix
  # CLOSED, as distinct from the rows it CLAIMS while open. Spelled with an underscore because every
  # multiword key in this register is (`inventory_rows`, `blocked_by`, `spec_refs`, `wrong_answer`) and a
  # property is addressed here as `note.<key>` — where a hyphen would at best need quoting and at worst
  # read as an operator. The decision's `closes-rows` is the concept's name, not the key's.
  note.closes_rows:
    displayName: Closed rows
  formula.harm:
    displayName: Harm
  # The `upstream` kind's structured fields (work.py UPSTREAM_KEYS; kb/Work PB3838).
  note.upstream_status:
    displayName: Upstream state
  note.upstream_class:
    displayName: Upstream class
  note.upstream_edition:
    displayName: ISO edition
  note.upstream_project:
    displayName: Project
  note.upstream_version:
    displayName: Version
  note.upstream_ref:
    displayName: Ticket
views:
  # ⛔ THE ONLY VIEW THAT DECIDES WHAT TO WORK ON. Ranked by what the defect DOES to a user's program, never by
  # its severity label: PB24 (FUNCTION LENGTH silently wrong) and PB39 (rule-id numbering, zero wrong answers)
  # are BOTH [MAJOR], and on 2026-08-04 the session picked PB39. This filter drops PB39 off the list entirely.
  #
  # ⛔ THE FILTER READ `wrong_answer or crashes` AND HID NINE OPEN ITEMS, FOUR OF THEM `rejects_legal_source` —
  # the outcome CLAUDE.md rule 4 forbids outright. A false REJECT crashes nothing and computes nothing wrong; it
  # simply stops the user's program compiling, and the two-flag predicate scored that as no harm at all. Measured
  # 2026-08-06 while closing PB48, whose own PB51 would have vanished the moment it was filed.
  # ⚠ THIS LIST IS THE SAME PREDICATE AS `work.py`'s HARM_FLAGS, WRITTEN IN A SECOND LANGUAGE BECAUSE IT MUST BE
  # (Bases YAML cannot import Python). `work.py check` asserts the two agree, flag for flag — the copies exist,
  # so something has to hold them together (feedback_one_rule_one_place).
  - type: table
    name: Fix next
    filters:
      and:
        - status != "landed"
        - status != "retired"
        - wrong_answer or crashes or rejects_legal_source or under_rejects
        - 'process_only == false'
        - 'formula.blocked == false'
    order:
      - id
      - severity
      - area
      - harm
      - silent
    sort:
      - property: severity
        direction: ASC
      - property: id
        direction: ASC
  - type: table
    name: Blocked
    filters:
      and:
        - status != "landed"
        - status != "retired"
        - 'formula.blocked == true'
    order: [id, kind, severity, area, blocked_by, harm]
  # Real work that harms nobody today — visible so it is DEFERRED on purpose rather than forgotten.
  # ⚠ ITS OLD NAME WAS A CLAIM IT COULD NOT SUPPORT. "Open but nobody gets a wrong answer" tested only
  # wrong_answer and crashes, so every item that merely REJECTS LEGAL SOURCE was parked here under a heading
  # asserting it was harmless. The filter is now the exact complement of Fix next.
  # An `upstream` record (kb/Work PB3838) describes a defect in ANOTHER project and is not our deferred work, so it is
  # not listed here; it has its own view below. `work.py check` asserts this filter names the kind.
  - type: table
    name: Open but no harm flag set
    filters:
      and:
        - status != "landed"
        - status != "retired"
        - 'kind != "upstream"'
        - 'wrong_answer == false'
        - 'crashes == false'
        - 'rejects_legal_source == false'
        - 'under_rejects == false'
    order: [id, kind, severity, area, harm]
    sort:
      - property: kind
        direction: ASC
  # ⭐ THE UPSTREAM RECORDS (kb/Work PB3838): GnuCOBOL's departures from ISO and its defects, each a note carrying a
  # minimal repro, the exact cobc command, the observed result, a checked ISO citation and the draft report. A view of
  # RECORDS to file when the owner approves the text, never of our work (every one is `process_only`).
  - type: table
    name: Upstream records
    filters:
      and:
        - 'kind == "upstream"'
    order: [id, upstream_status, upstream_project, upstream_class, upstream_edition, upstream_version, upstream_ref, area]
    sort:
      - property: upstream_status
        direction: ASC
      - property: id
        direction: ASC
  - type: table
    name: Analyses (§11 backlog)
    filters:
      and:
        - 'kind == "analysis"'
    order: [id, status, area]
    sort:
      - property: status
        direction: ASC
  # ⭐ WHAT EACH LANDING CLOSED — the `closes_rows` back-link, read the way a reader asks the question: which
  # inventory rows does this finished work account for? It is a view of FINISHED work and is deliberately not a
  # worklist (CLAUDE.md rule 8); `Fix next` remains the only view that says what to do.
  - type: table
    name: Landed — rows closed
    filters:
      and:
        - 'kind == "defect"'
        - 'status == "landed" or status == "retired"'
    order: [id, area, closes_rows, closes_rows_reason]
    sort:
      - property: id
        direction: ASC
  - type: table
    name: Everything
    order: [id, kind, status, severity, area, harm, closes_rows]
    sort:
      - property: kind
        direction: ASC
      - property: id
        direction: ASC
