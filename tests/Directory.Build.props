<Project>

  <!--
    Test-tree props. MSBuild stops at the FIRST Directory.Build.props found walking up, so the repo-root one is
    imported explicitly — without this line every test project silently loses TargetFramework, Nullable,
    TreatWarningsAsErrors and the rest.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    ⛔ SERVER GC FOR EVERY TEST HOST (kb/Work PB2526). The gate's legs compile thousands of COBOL programs on every
    core of one test host, and under the default WORKSTATION GC one heap suspends every allocating thread: a 32-thread
    compile probe spent 69 % of its wall in GC pauses and stopped scaling past about 8 threads. Server GC (DATAS, the
    .NET 10 default, bounds its heap count and memory) took the whole Conformance leg from 318 s to 255 s and Unit from
    74 s to 56 s with identical pass sets. It reaches only the test hosts: the COBOL programs a test runs are child
    processes with their own runtimeconfig. Set here, not per project, because IsTestProject is set later in each
    project file; the benchmark host pins its own GC mode in its project file (measurement stability), and the
    project BenchmarkDotNet generates is left to BenchmarkDotNet. Each gated assembly's GateLegDriftTests asserts its
    host's runtimeconfig carries System.GC.Server, so it cannot silently revert.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <!--
    ⛔ NOT into a BenchmarkDotNet host project. BenchmarkDotNet builds each benchmark run through a project it
    GENERATES under tests/Cobol.Net.Benchmarks/bin/…/, so that project inherits this file too; it references the
    benchmark assembly (which links the one helper it needs) and has no xunit, so the xunit-based helpers here
    (GateLegs.cs, GateLegAudit.cs, kb/Work PB1719) failed its build, and every benchmark case reported NA until
    kb/Work PB2117 found it.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">
    <!--
      ONE repo-root locator for every test project (tests/_shared/TestRepo.cs). Linked rather than referenced as a
      project so a NEW test project under tests/ inherits it with no wiring — which is what stops the sixteen
      private RepoRoot() walkers this replaced from growing back one project at a time.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)_shared\*.cs" Link="_shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    THE GATE'S FRAMEWORK (kb/Work PB1719; docs/rearchitecture/DESIGN-test-build-ci.md section 3.14.3): every test
    project runs under CobolNet.Gate.GateTestFramework (_shared/GateLegs.cs), which runs exactly one leg of the
    gate's plan when the gate driver hands it a complete handshake, and is xunit's own framework otherwise. The
    attribute names the assembly, which a linked source file cannot, so it is written here. xunit resolves it by that
    name and silently runs its default framework on a miss; GateLegDriftTests pins it in every gated assembly.
    ⛔ The impact-recording build (tools/impact/ImpactRecording.targets) defines IMPACT_RECORDING and names its own
    ImpactTestFramework (derived from GateTestFramework) instead: an assembly names exactly one framework. Item
    conditions are evaluated after every property, so this sees the recording targets' DefineConstants.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true' and '$([System.String]::Copy(`;$(DefineConstants);`).Contains(`;IMPACT_RECORDING;`))' != 'true'">
    <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
      <_Parameter1>CobolNet.Gate.GateTestFramework</_Parameter1>
      <_Parameter2>$(AssemblyName)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
