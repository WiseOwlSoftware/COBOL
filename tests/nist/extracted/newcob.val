000400****************************************************************  SQ2074.2
000500*                                                              *  SQ2074.2
000600*    VALIDATION FOR:-                                          *  SQ2074.2
000700*    " HIGH       ".                                              SQ2074.2
000800*                                                              *  SQ2074.2
