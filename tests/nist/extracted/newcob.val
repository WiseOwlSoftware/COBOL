060900*   WRITE   OUTPUT-RECORD.                                       *SQ2124.2
061000******************************************************************SQ2124.2
061100     ADD 1 TO COUNT-OF-RECS.                                      SQ2124.2
061200     ADD 1 TO RECORD-LENGTH.                                      SQ2124.2
