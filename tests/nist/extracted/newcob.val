000400****************************************************************  RL2104.2
000500*                                                              *  RL2104.2
000600*    VALIDATION FOR:-                                          *  RL2104.2
000700*                                                              *  RL2104.2
000800*    "ON-SITE VALIDATION, NATIONAL INSTITUTE OF STD & TECH.     ".RL2104.2
000900*                                                              *  RL2104.2
