000400****************************************************************  SQ1124.2
000500*                                                              *  SQ1124.2
000600*    VALIDATION FOR:-                                          *  SQ1124.2
000700*    "ON-SITE VALIDATION, NATIONAL INSTITUTE OF STD & TECH.     ".SQ1124.2
000800*                                                              *  SQ1124.2
000900*    CREATION DATE     /     VALIDATION DATE                   *  SQ1124.2
001000*    "COBOL 85 VERSION 4.2, Apr  1993 SSVG                      ".SQ1124.2
