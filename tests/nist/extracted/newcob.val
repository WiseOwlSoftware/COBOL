029200     IF SQ-FS4-STATUS = "10"                                      SQ1224.2
029300             GO TO END-DECLS.                                     SQ1224.2
029400     IF SQ-FS4-STATUS = "46"                                      SQ1224.2
029500             PERFORM DECL-PASS                                    SQ1224.2
029600             GO TO ABNORMAL-TERM-DECL                             SQ1224.2
029700     ELSE                                                         SQ1224.2
