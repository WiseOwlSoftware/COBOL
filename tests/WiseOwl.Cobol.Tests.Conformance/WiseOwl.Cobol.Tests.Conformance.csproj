<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WiseOwl.Cobol.Tests.Conformance — the conformance/differential harness for the greenfield WiseOwl COBOL compiler.
    It compiles and runs the NIST CCVS corpus against its committed goldens (tests/nist/corpus.tsv), the
    differential cases against their committed goldens (tests/differential/) and the conformance suite
    (conformance-suite/, through the generator's wiseowl manifest). It references only the greenfield projects.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WiseOwl.Cobol.Compiler\WiseOwl.Cobol.Compiler.csproj" />
    <ProjectReference Include="..\..\src\WiseOwl.Cobol.Runtime\WiseOwl.Cobol.Runtime.csproj" />
    <!--
      The cobol command, BUILT (in this configuration) but not referenced: ConformanceSuiteRunnerDriftTests runs the
      conformance suite's run.py through the WiseOwl adapter, which drives the cobol command, and CI's Conformance legs
      build this project alone (DESIGN-conformance-suite.md §5, kb/Work PB3176).
    -->
    <ProjectReference Include="..\..\src\WiseOwl.Cobol.Cli\WiseOwl.Cobol.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
