D1 MOVE DL(1:5) TO T(I)
  EC-BOUND-REF-MOD
D2 STRING DL(1:5) INTO T(I)
  EC-BOUND-REF-MOD
D3 COMPUTE N(I) = FUNCTION NUMVAL(DL(1:5))
  EC-BOUND-REF-MOD
D4 MOVE DL(1:5) TO T(I) T(J)
  EC-BOUND-REF-MOD
F1 MOVE X(1:20) TO T(I)
  EC-BOUND-REF-MOD
R1 MOVE T(I) TO DL(1:5)
  EC-BOUND-SUBSCRIPT
V1 MOVE DL(1:2) TO T(J)
  T(J)=AB  
V2 STRING DL(2:1) INTO T(J)
  T(J)=B   
V3 COMPUTE N(J) = FUNCTION NUMVAL(DL(1:2))
  N(J)=0042
V4 MOVE X(3:4) TO T(J)
  T(J)=CDEF
END
