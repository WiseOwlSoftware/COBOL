C*C       SIZE ERROR F=7 EC-SIZE-OVERFLOW               
C**2      SIZE ERROR F=7 EC-SIZE-OVERFLOW               
T*T       SIZE ERROR F=7 EC-SIZE-UNDERFLOW              
T/C       SIZE ERROR F=7 EC-SIZE-UNDERFLOW              
ADD       SIZE ERROR F=1E+308 EC-SIZE-OVERFLOW               
SUBTRACT  SIZE ERROR F=-1E+308 EC-SIZE-OVERFLOW               
MULTIPLY  SIZE ERROR F=10000000000 EC-SIZE-OVERFLOW               
SUM       SIZE ERROR F=7 EC-SIZE-OVERFLOW               
DIVIDE    SIZE ERROR F=7 EC-SIZE-ZERO-DIVIDE            
FL/FZ     SIZE ERROR F=7 EC-SIZE-ZERO-DIVIDE            
A=FL/FZ   SIZE ERROR A=007 EC-SIZE-ZERO-DIVIDE            
C*10      NOT ON SIZE ERROR F=1E+301
T/1E10    NOT ON SIZE ERROR F=1E-310
NO PHRASE C*C
  DECLARATIVE EC-SIZE-OVERFLOW               
F=7
IF FL / FZ > 1
  DECLARATIVE EC-SIZE-ZERO-DIVIDE            
END
